{
  "name": "pantry-pal-mcp",
  "version": "1.0.0",
  "description": "Alexa+ MCP server (Streamable HTTP) that tracks your pantry and uses Amazon Bedrock to suggest zero-waste recipes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "agent": "tsx src/demo-agent.ts",
    "inspector": "npx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
