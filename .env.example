# AWS (credentials come from the default chain: `aws configure`, AWS_PROFILE, or env vars)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# MCP server
HOST=127.0.0.1
PORT=3000
# Set this before exposing the server through a tunnel. Clients must send `Authorization: Bearer <token>`.
MCP_AUTH_TOKEN=
# Comma-separated browser origins allowed to call /mcp (requests without an Origin header are always allowed)
ALLOWED_ORIGINS=
# Where household data is stored: file (default, local) or dynamodb (hosted, multi-household)
STORE=file
DATA_FILE=./data/pantry.json
# For STORE=dynamodb: table with a String partition key named "pk"
DYNAMODB_TABLE=pantry-pal
DYNAMODB_REGION=ap-southeast-2
# Multi-household mode: each bearer key maps to a household id. Leave empty for single-user local use.
# HOUSEHOLD_KEYS=long-random-key-1:smith-family,long-random-key-2:demo

# Demo agent and web app
MCP_URL=http://127.0.0.1:3000/mcp
WEB_PORT=3001
# Amazon Polly neural voice for the web app (e.g. Joanna, Matthew, Ruth)
POLLY_VOICE=Joanna
